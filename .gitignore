migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Signing / secrets — never commit these
android/key.properties
*.jks
*.keystore
.env
.env.*

# App keys (Supabase URL/anon key, NAVER ids) — passed via --dart-define-from-file
.env.json
# Supabase CLI local secrets, if the Edge Function is ever set up via CLI
supabase/.env
supabase/functions/.env

# Built APKs shared with the team (contain app keys) — never commit
배포/
*.apk
